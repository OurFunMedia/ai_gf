# Agnes AI API Configuration
# Get your free API key from https://agnes-ai.com
VITE_AGNES_API_KEY=your_api_key_here
VITE_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_AGNES_CHAT_MODEL=agnes-2.0-flash
VITE_AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# NVIDIA NIM API (for prompt expansion via MiniMax M3)
# Get your free API key from https://build.nvidia.com/minimaxai/minimax-m3
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VITE_NVIDIA_CHAT_MODEL=minimaxai/minimax-m3
