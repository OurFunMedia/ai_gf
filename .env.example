# NVIDIA NIM API Key — 取代 Agnes 做聊天（minimax-m2.7）
VITE_NVIDIA_API_KEY=your_nvapi_key_here

# Agnes AI API 設定（前端只用來選 model，實際 API key 由 Worker proxy 注入）
# AGNES_API_KEY 設為 Cloudflare Worker secret，名稱同 Worker: AGNES_API_KEY
VITE_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_AGNES_CHAT_MODEL=agnes-2.0-flash
VITE_AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# Prompt expansion proxy (Cloudflare Worker, CORS-safe) — 目前指向 Zen 免費模型
# Worker 另有 AGNES_API_KEY secret（image generation proxy）
# 舊版 NVIDIA Worker（備用，含 AGNES 生圖路由）：https://ai-gf-nvidia-proxy.tobyyip-work.workers.dev
VITE_NVIDIA_WORKER_URL=https://ai-gf-zen-proxy-production.tobyyip-work.workers.dev
